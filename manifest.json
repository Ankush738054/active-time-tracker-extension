{
  "manifest_version": 3,
  "name": "Active Time Tracker",
  "version": "0.1.0",
  "description": "Tracks active website time across Chrome and Brave, synced under a single user account.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
